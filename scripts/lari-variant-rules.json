{
  "$schema": "./lari-variant-rules.schema.md",
  "phraseRules": [
    {
      "id": "mankondi-nzololo-dia",
      "lari": "Mankondi nzololo dia",
      "correct": {
        "fr": "J'aimerais manger les bananes",
        "en": "I would like to eat bananas",
        "pt": "Eu gostaria de comer bananas"
      },
      "wrong": {
        "fr": [
          "Tu aimes manger les bananes",
          "Tu aimerais manger les bananes",
          "Il aimerait manger les bananes",
          "J'aime manger les bananes",
          "Je veux manger les bananes"
        ],
        "en": [
          "You like to eat bananas",
          "You would like to eat bananas",
          "He would like to eat bananas",
          "I like to eat bananas",
          "I want to eat bananas"
        ],
        "pt": [
          "Voce gosta de comer bananas",
          "Você gosta de comer bananas",
          "Você gostaria de comer bananas",
          "Eu gosto de comer bananas"
        ]
      }
    }
  ],
  "textRules": [
    {
      "id": "bv-to-v",
      "description": "Orthographe moderne : bv -> v (vuka, vukana, vuna, vuama...)",
      "pattern": "\\bbv(uka|ukana|una|uama|uanganana)\\b",
      "flags": "gi",
      "replacement": "v$1"
    },
    {
      "id": "mbuma-not-fruit",
      "description": "Mbuma = chat, jamais 'fruit'. Signale (sans corriger auto) toute association mbuma/fruit.",
      "pattern": "\\bmbuma\\b[^\\n]{0,80}\\b(fruit|fruits)\\b",
      "flags": "gi",
      "reportOnly": true,
      "skipIfLineContains": [
        "distractors",
        "options:"
      ]
    },
    {
      "id": "nkelele-pintade",
      "description": "Nkelele = une pintade (jamais mille-pattes).",
      "pattern": "\\bnkelele\\b[^\\n]{0,60}mille[- ]pattes?",
      "flags": "gi",
      "reportOnly": true,
      "skipIfLineContains": [
        "distractors",
        "options:"
      ]
    },
    {
      "id": "ngongolo-mille-pattes",
      "description": "Ngongolo = un mille-pattes (jamais pintade).",
      "pattern": "\\bngongolo\\b[^\\n]{0,60}pintade",
      "flags": "gi",
      "reportOnly": true,
      "skipIfLineContains": [
        "distractors",
        "options:"
      ]
    },
    {
      "id": "ba-bantu-two-words",
      "description": "ba bantu = etre humains, toujours en deux mots.",
      "pattern": "\\bbabantu\\b",
      "flags": "gi",
      "replacement": "ba bantu"
    },
    {
      "id": "ba-mindele-two-words",
      "description": "ba mindele = les choses des Blancs, toujours en deux mots.",
      "pattern": "\\bbamindele\\b",
      "flags": "gi",
      "replacement": "ba mindele"
    },
    {
      "id": "bimenina-one-word",
      "description": "bimenina = les vegetaux, en un seul mot.",
      "pattern": "\\bbi\\s+mene\\s+mena\\b|\\bbi\\s+menina\\b",
      "flags": "gi",
      "replacement": "bimenina"
    },
    {
      "id": "zonzesa-typo",
      "description": "Faute de frappe zonzesz -> zonzesa.",
      "pattern": "\\bzonzesz\\b",
      "flags": "gi",
      "replacement": "zonzesa"
    }
  ]
}